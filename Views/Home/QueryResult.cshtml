<h1>Результаты SQL-запроса</h1>
<table border="1">
    @if (Model.Count > 0)
    {
        <tr>
            @foreach (var key in Model[0].Keys)
            {
                <th>@key</th>
            }
        </tr>
        @foreach (var row in Model)
        {
            <tr>
                @foreach (var value in row.Values)
                {
                    <td>@value</td>
                }
            </tr>
        }
    }
    else
    {
        <tr><td>Нет данных</td></tr>
    }
</table>
